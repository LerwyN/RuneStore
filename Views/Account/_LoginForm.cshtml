@model RUNE.Models.ViewModels.Account.LoginViewModel

<form asp-controller="Account" asp-action="Login" method="post" class="rune-auth-form">
    <div asp-validation-summary="ModelOnly" class="rune-auth-validation"></div>

    <div class="rune-auth-field">
        <label asp-for="UserName" class="rune-auth-label"></label>
        <input asp-for="UserName" class="rune-auth-input" autocomplete="username" placeholder="Kullanıcı adın" />
        <span asp-validation-for="UserName" class="rune-auth-error"></span>
    </div>

    <div class="rune-auth-field">
        <div class="rune-auth-password-heading">
            <label asp-for="Password" class="rune-auth-label"></label>
            <a href="#forgot-password" class="rune-auth-link">Şifremi unuttum?</a>
        </div>
        <input asp-for="Password" class="rune-auth-input" autocomplete="current-password" placeholder="Şifren" />
        <span asp-validation-for="Password" class="rune-auth-error"></span>
    </div>

    <button type="submit" class="rune-auth-submit">Giriş Yap</button>

    <div class="rune-auth-divider"><span>Diğer giriş yöntemleri</span></div>
    <div class="rune-auth-provider-grid" aria-label="Diğer giriş yöntemleri">
        <button type="button" class="rune-auth-provider-btn" aria-label="Google ile giriş">
            <img src="https://img.icons8.com/?size=100&id=17949&format=png&color=000000" alt="Google" style="width: auto; height: 20px;">
            <span>Google</span>
        </button>
        <button type="button" class="rune-auth-provider-btn" aria-label="Steam ile giriş">
            <a href="https://commons.wikimedia.org/wiki/File:Steam_icon_logo.svg" title="Steam, Public domain, via Wikimedia Commons"><img width="20" height="20" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/960px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail" srcset="https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/250px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 250w, https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/500px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 500w, https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/960px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 960w, https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/1280px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 1280w, https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/3840px-Steam_icon_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 3840w" sizes="auto" loading="lazy" alt="Steam official logo"></a>
            <span>Steam</span>
        </button>
        <button type="button" class="rune-auth-provider-btn" aria-label="Epic Games ile giriş">
            <a href="https://commons.wikimedia.org/wiki/File:Epic_Games_logo.svg" title="Epic Games, Public domain, via Wikimedia Commons"><img width="18" height="20" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Epic_Games_logo.svg/960px-Epic_Games_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail" srcset="https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Epic_Games_logo.svg/250px-Epic_Games_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 250w, https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Epic_Games_logo.svg/500px-Epic_Games_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 500w, https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Epic_Games_logo.svg/960px-Epic_Games_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 960w, https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Epic_Games_logo.svg/1920px-Epic_Games_logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=index&amp;utm_content=thumbnail 1920w" sizes="auto" loading="lazy" alt="Logo of Epic Games since 2015"></a>
            <span>Epic Games</span>
        </button>
    </div>

    <p class="rune-auth-register-prompt">
        Hesabın mı yok? <a asp-controller="Account" asp-action="Register" class="rune-auth-link">Kayıt ol</a>
    </p>

    <button type="button" class="rune-auth-link rune-auth-help-button">Giriş yaparken sorun mu yaşıyorsun?</button>
</form>