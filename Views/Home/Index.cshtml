@model IEnumerable<RUNE.Models.Game>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    ViewData["Title"] = "Rune'ye Hoş Geldiniz";
    var featuredGames = Model.Take(5).ToList();
    var catalogGames = Model.Where(game => game.Slug == "grand-theft-auto-v").ToList();
}


@* mağaza araması ve alt menü *@
<div class="search-filter-row">
    <div class="search-container">
        <div class="search">
            <button>
                <img src="https://img.icons8.com/?size=100&id=TQPOC8XaUqZ0&format=png&color=ffffff" alt="">
            </button>
            <input type="text" placeholder="Mağazada ara">
            <span class="search-new-badge" aria-label="Yeni">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 3.5 13.8 9l5.7 1.8-5.7 1.8-1.8 5.7-1.8-5.7-5.7-1.8L10.2 9 12 3.5Z" />
                    <path d="m19 15.5.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z" />
                </svg>
                <span>Yeni</span>
            </span>
        </div>
    </div>
    <nav class="store-subnav" aria-label="Mağaza menüsü">
        <a href="#featuredBanner" class="active">Kategoriler</a>
        <a href="#all-games-heading">Göz At</a>
        <a class="whats-new-trigger" data-whats-new-open aria-haspopup="dialog" aria-controls="whatsNewOverlay" title="Rune'de neler değişti haberdar ol">
            <span>Sürüm Notları</span>
        </a>
    </nav>
</div>


@* oyun banner yer aldı alan ve sağ taraf *@
<div class="store-layout">
    <main class="store-main">
        <div class="featured-showcase">
            <div class="featured-game">
                <div class="banner banner-special-active" id="featuredBanner"
                        style="--banner-image: linear-gradient(to right, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 50%, rgba(0, 0, 0, 0) 100%), url('/images/Specials/holloween-sale.png');">
                    <div class="banner-content">
                        <h1 id="bannerTitle">Cadılar Bayramı İndirimi</h1>
                        <p id="bannerDescription">Cadılar Bayramı'na özel seçili oyunlarda indirimleri keşfet.</p>
                        <div class="banner-buttons">
                            <button type="button" id="detailsButton">
                                İncele
                            </button>
                            <button type="button" id="wishlistButton" class="banner-wishlist-button" aria-label="İstek listesine ekle">
                                <img src="https://img.icons8.com/?size=100&amp;id=qePzjQLJYgjF&amp;format=png&amp;color=ffffff" alt="" aria-hidden="true" />
                            </button>
                        </div>
                        <div class="banner-progress">
                            <div class="banner-progress-fill"></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (featuredGames.Any())
            {
                <aside class="featured-game-list" aria-label="Öne çıkan oyunlar">
                    <button type="button"
                            class="featured-game-option featured-promo-option active"
                            data-featured-title="Cadılar Bayramı İndirimi"
                            data-featured-description="Cadılar Bayramı'na özel seçili oyunlarda indirimleri keşfet."
                            data-featured-image="/images/Specials/holloween-sale.png"
                            data-featured-kind="special"
                            aria-pressed="true">
                        <img src="/images/Specials/holloween-profile.png" alt="" loading="lazy" />
                        <span class="featured-game-option-title">Cadılar Bayramı İndirimi</span>
                    </button>
                    @foreach (var game in featuredGames)
                    {
                        var thumbnailPath = string.IsNullOrWhiteSpace(game.CoverImagePath)
                            ? game.BannerImagePath
                            : game.CoverImagePath;

                        <button type="button"
                                class="featured-game-option"
                                data-featured-title="@game.Title"
                                data-featured-description="@game.Description"
                                data-featured-image="@(string.IsNullOrWhiteSpace(game.BannerImagePath) ? thumbnailPath : game.BannerImagePath)"
                                aria-pressed="false">
                            <img src="@thumbnailPath" alt="" loading="lazy" />
                            <span class="featured-game-option-title">@game.Title</span>
                        </button>
                    }
                </aside>
            }
        </div>
        <section class="catalog-section" aria-labelledby="all-games-heading">
            <h2 id="all-games-heading">Popüler Oyunlar</h2>
            @if (catalogGames.Any())
            {
                <div class="catalog-games">
                    @foreach (var game in catalogGames)
                    {
                        <article class="catalog-game-card">
                            <a href="">
                                <img class="catalog-game-banner"
                                src="@game.BannerImagePath"
                                alt="@game.Title oyun görseli"
                                loading="lazy" />
                            </a>
                            <div class="catalog-game-info">
                                <h3>@game.Title</h3>
                                @if (game.Price > 0)
                                {
                                    <span class="catalog-game-price">₺ @game.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span>
                                }
                                else
                                {
                                    <span class="catalog-game-price catalog-game-price-pending">Fiyat yakında</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="catalog-empty">Mağazada henüz yayımlanmış oyun yok.</p>
            }
        </section>
    </main>
</div>
