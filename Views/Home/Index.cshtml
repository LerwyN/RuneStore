@model IEnumerable<RUNE.Models.Game>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    ViewData["Title"] = "Rune'ye Hoş Geldiniz";
}


@* arama ve filter bölümü *@
<div class="search-filter-row">
    <div class="search-container">
        <div class="search">
            <button>
                <img src="https://img.icons8.com/?size=100&id=TQPOC8XaUqZ0&format=png&color=ffffff" alt="">
            </button>
            <input type="text" placeholder="Oyun, DLC, kategori ara...">
        </div>
    </div>
    <div class="filter-wrapper">
        <button class="filter-button" title="Filtreler">
            <img src="https://img.icons8.com/?size=100&id=69913&format=png&color=ffffff" alt="">
        </button>
        <div class="filter-panel">
            <h3>Fiyata göre daralt</h3>
            <div class="price-filter">
                <span>0 TL</span>
                <span>5000 TL</span>
                <input type="range" min="0" max="5000" value="5000">
            </div>
            <label>
                <input type="checkbox">
                İndirimler ve etkinlikler
            </label>
            <label>
                <input type="checkbox">
                Ücretsiz oyunlar
            </label>
            <hr>
            <h3>Oyun türü</h3>
            <label>
                <input type="checkbox" value="aksiyon">
                Aksiyon
            </label>
            <label>
                <input type="checkbox" value="macera">
                Macera
            </label>
            <label>
                <input type="checkbox" value="rpg">
                RPG
            </label>
            <label>
                <input type="checkbox" value="strateji">
                Strateji
            </label>
            <div class="filter-actions">
                <button type="button" class="clear-filters">Temizle</button>
                <button type="button" class="apply-filters">Uygula</button>
            </div>
        </div>
    </div>
</div>


@* oyun banner yer aldı alan ve sağ taraf *@
<div class="store-layout">
    <main class="store-main">
        <div class="featured-game">
            <div class="banner" id="featuredBanner">
                <div class="banner-content">
                    <h1 id="bannerTitle">Grand Theft Auto VI</h1>
                    <p id="bannerDescription">
                        Vice City'de suç ve özgürlüğün sınırlarını keşfet.
                    </p>
                    <div class="banner-buttons">
                        <button type="button" id="detailsButton">
                            İncele
                        </button>
                        <button type="button" id="wishlistButton" class="banner-wishlist-button" aria-label="İstek listesine ekle">
                            <img src="https://img.icons8.com/?size=100&amp;id=qePzjQLJYgjF&amp;format=png&amp;color=ffffff" alt="" aria-hidden="true" />
                        </button>
                    </div>
                    <div class="banner-progress">
                        <div class="banner-progress-fill">
                
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <section class="catalog-section" aria-labelledby="all-games-heading">
            <h2 id="all-games-heading">Popüler Oyunlar</h2>
            @if (Model.Any())
            {
                <div class="catalog-games">
                    @foreach (var game in Model)
                    {
                        <article class="catalog-game-card">
                            <img class="catalog-game-banner"
                                 src="@game.BannerImagePath"
                                 alt="@game.Title oyun görseli"
                                 loading="lazy" />
                            <div class="catalog-game-info">
                                <h3>@game.Title</h3>
                                <span class="catalog-game-price">₺ @game.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="catalog-empty">Mağazada henüz yayımlanmış oyun yok.</p>
            }
        </section>
    </main>
    <aside class="store-sidebar">
        <section class="sidebar-card notification-card">
            <div class="notification-heading">
                <img src="https://img.icons8.com/?size=100&id=115225&format=png&color=ffffff" alt="">
                <h3>Aktivite Akışı</h3>
            </div>
            <div class="wobbo">
                <h6>Hmm, Şu anlık burası sessiz</h6>
                <p>Yeni bildirimlerin olduğunda burada olacağız</p>
            </div>
        </section>
        <section class="sidebar-card deal-card">
            <div class="deal-content">
                <div class="deal-heading">
                    <img src="https://img.icons8.com/?size=100&id=3103&format=png&color=ffffff" alt="">
                    <h3>Özel Fırsat</h3>
                </div>
                <div class="deal-timer">
                    <img src="https://img.icons8.com/?size=100&id=108863&format=png&color=ffffff" alt="">
                    <p>24:00:00</p>
                </div>
            </div>
            <div class="deal-game">
                <img class="deal-favorite" src="https://img.icons8.com/?size=100&id=64767&format=png&color=ffffff"
                    alt="">
                <span class="deal-discount">-45%</span>
            </div>
            <div class="deal-price">
                <h4>Red Dead Redemption II</h4>
                <div class="price-details">
                    <span class="old-price">₺ 2.099,00</span>
                    <span class="new-price">₺ 1.154,45</span>
                </div>
            </div>
        </section>
        <section class="sidebar-card">
            <img src="https://img.icons8.com/?size=100&id=yZX1GOetNQCq&format=png&color=ffffff" alt=""> <h3>Arkadaşlarım</h3>
        </section>
    </aside>
</div>
