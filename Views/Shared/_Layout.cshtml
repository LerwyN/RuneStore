@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var runeVersion = "v0.1.11 Beta";
}
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="~/images/icons/RuneDarkIcon.png">
</head>

<body>
    <header class="site-header">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a class="rune-icon">
                    <img src="~/images/icons/RuneStore.png" alt="rune">
                </a>
            </div>
            <nav class="navbar-middle">
                <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")"
                   title="Sıradaki Maceranı Keşfet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="26" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-bag">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path
                        d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" />
                        <path d="M9 11v-5a3 3 0 0 1 6 0v5" />
                    </svg>
                    Mağaza
                </a>
                <a asp-controller="Library" asp-action="Index" class="@(currentController == "Library" ? "active" : "")"
                   title="Atölye Keşfet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-tool">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />
                    </svg>
                    Atölye
                </a>
                <a asp-controller="Community" asp-action="Index"
                   class="@(currentController == "Community" ? "active" : "")" title="Oyun Dünyasının Buluşma Noktası">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-users">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                        <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                    </svg>
                    Topluluk
                </a>
                <a asp-controller="News" asp-action="Index" class="@(currentController == "News" ? "active" : "")"
                   title="Oyun Dünyasından Haberdar Ol">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-news">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path
                        d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1 -4 0v-13a1 1 0 0 0 -1 -1h-10a1 1 0 0 0 -1 1v12a3 3 0 0 0 3 3h11" />
                        <path d="M8 8l4 0" />
                        <path d="M8 12l4 0" />
                        <path d="M8 16l4 0" />
                    </svg>
                    Haberler
                </a>
                <a asp-controller="Support" asp-action="Index" class="@(currentController == "Support" ? "active" : "")"
                   title="Her Adımda Yanındayız">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-help">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                        <path d="M12 17l0 .01" />
                        <path d="M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4" />
                    </svg>
                    Destek
                </a>
                <span class="nav-divider"></span>
                <a href="#" title="Oyun Dünyası Seni Bekliyor">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-download">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
                        <path d="M7 11l5 5l5 -5" />
                        <path d="M12 4l0 12" />
                    </svg>
                    Rune'yi İndir
                </a>
                <span class="nav-active-pill"></span>
            </nav>
            <div class="navbar-right">

                @* Diller eklenecek *@

                <div class="wishlist-icon">
                    <div class="utility-item">
                        <a href="#" title="İstek Listesi">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-tabler icons-tabler-outline icon-tabler-bookmark">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M18 7v14l-6 -4l-6 4v-14a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4" />
                            </svg>
                        </a>
                    </div>
                    <div class="utility-item">
                        <a href="#" title="Hediye Et">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                 stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-gift">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path
                                d="M3 9a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1l0 -2" />
                                <path d="M12 8l0 13" />
                                <path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7" />
                                <path
                                d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5" />
                            </svg>
                        </a>
                    </div>
                    <div class="utility-item">
                        <a href="#" title="Sepetim">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                 fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M4 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                <path d="M15 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                <path d="M17 17h-11v-14h-2" />
                                <path d="M6 5l14 1l-1 7h-13" />
                            </svg>
                        </a>
                    </div>
                </div>
        
                <div class="profile-card">
                    <a class="user-icon" title="Profilim" href="#">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
                             stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                            <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                            <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                        </svg>
                    </a>
                    <div class="profile-info">
                        <h6 class="profile-name">Rune User</h6>
                        <p class="profile-level">Seviye 1</p>
                    </div>
                    <button class="profile-menu-toggle" id="profileMenuToggle" type="button"
                            aria-label="Profil menüsünü aç" aria-expanded="false">
                        <img class="" src="https://img.icons8.com/?size=100&id=99991&format=png&color=ffffff" alt="">
                    </button>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="profile-dropdown-header">
                            <strong>Test &</strong>
                            <span> Seviye 1 · Admin</span>
                        </div>
                        <a href="#" class="profile-dropdown-item">
                            <img src="https://img.icons8.com/?size=100&id=iBZNHkGbms4H&format=png&color=ffffff" alt="">
                            Profilim
                        </a>
                        <a href="#" class="profile-dropdown-item">
                            <img src="https://img.icons8.com/?size=100&id=4511GGVppfIx&format=png&color=000000"
                                 alt="">Ayarlar
                        </a>
                        <div class="profile-dropdown-divider"></div>
                        <button type="button" class="profile-dropdown-item dark-theme-btn">
                            <img src="https://img.icons8.com/?size=100&id=xlD3xOrQjTJO&format=png&color=000000"
                                 alt="">Koyu Tema
                        </button>
                        <button type="button" class="profile-dropdown-item light-theme-btn">
                            <img src="https://img.icons8.com/?size=100&id=648&format=png&color=000000" alt=""> Beyaz
                            Tema
                        </button>
                        <div class="profile-dropdown-divider"></div>
                        <button type="button" class="profile-dropdown-item logout-link">
                            <img src="https://img.icons8.com/?size=100&id=3HSHWjvK9Yxq&format=png&color=d90000"
                                 alt="">Çıkış Yap
                        </button>
                    </div>
                </div>
            </div>
            <button class="mobile-menu-button" id="mobileMenuToggle" type="button" aria-label="Menüyü aç"
                    aria-expanded="false" aria-controls="mobileMenu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
        <nav class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-profile">
                <img src="https://img.icons8.com/?size=100&id=iBZNHkGbms4H&format=png&color=ffffff" alt="Profil">
                <div>
                    <strong>Test</strong>
                    <p>Seviye 1</p>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Index">
                <img src="https://img.icons8.com/?size=100&id=8386&format=png&color=ffffff" alt="">
                Mağaza
            </a>
            <a asp-controller="Library" asp-action="Index">
                <img src="https://img.icons8.com/?size=100&id=I5gVRW50I5mu&format=png&color=ffffff" alt="">
                Atölye & Araçlar
            </a>
            <a asp-controller="Community" asp-action="Index">
                <img src="https://img.icons8.com/?size=100&id=L6JR1iP6qIT5&format=png&color=ffffff" alt="">
                Topluluk
            </a>
            <a asp-controller="News" asp-action="Index">
                <img src="https://img.icons8.com/?size=100&id=mNrmemIKiHu9&format=png&color=ffffff" alt="">
                Haberler
            </a>
            <a asp-controller="Support" asp-action="Index">
                <img src="https://img.icons8.com/?size=100&id=83756&format=png&color=ffffff" alt="">
                Destek
            </a>
            <div class="mobile-menu-divider"></div>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=1EMGz1hotW1E&format=png&color=ffffff" alt="">
                Hediye Et
            </a>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=qePzjQLJYgjF&format=png&color=ffffff" alt="">
                İstek Listem
            </a>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=iBXDn4eGtFfA&format=png&color=ffffff" alt="">
                Bildirimler
            </a>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=Nf4fef5uGONQ&format=png&color=ffffff" alt="">
                Sepetim
            </a>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=ffffff" alt="">
                Profilim
            </a>
            <a href="#">
                <img src="https://img.icons8.com/?size=100&id=4511GGVppfIx&format=png&color=ffffff" alt="">
                Ayarlar
            </a>
            <hr class="border border-white">
            <a href="#" class="logout-link">
                <img src="https://img.icons8.com/?size=100&id=3HSHWjvK9Yxq&format=png&color=d90000" alt="">
                Çıkış Yap
            </a>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <footer class="rune-footer">
        <div class="rune-footer-header">
            <h2 class="rune-store">STORE</h2>
            <div class="rune-footer-socials">
                <a href="https://discord.gg/6xXKfcKhHJ" aria-label="Discord" title="Discord">
                    <img src="https://img.icons8.com/?size=100&id=B9UPHsL3gHI2&format=png&color=ffffff" alt="Discord" />
                </a>
                <a href="https://github.com/LerwyN/Rune-Game-Platform" aria-label="GitHub" title="GitHub">
                    <img src="https://img.icons8.com/?size=100&id=106567&format=png&color=ffffff" alt="GitHub" />
                </a>
                <a href="https://x.com/RuneStoreG" aria-label="X" title="X">
                    <img src="https://img.icons8.com/?size=100&id=phOKFKYpe00C&format=png&color=ffffff" alt="X" />
                </a>
                <a href="https://www.instagram.com/runestoreofficial/" aria-label="Instagram" title="Instagram">
                    <img src="https://img.icons8.com/?size=100&id=32309&format=png&color=ffffff" alt="Instagram" />
                </a>
                <a href="https://www.youtube.com/RuneStoree" aria-label="YouTube" title="YouTube">
                    <img src="https://img.icons8.com/?size=100&id=37326&format=png&color=ffffff" alt="YouTube" />
                </a>
            </div>
        </div>
        <div class="rune-footer-main">
            <div class="rune-footer-about ">
                <h3>Oyun dünyasının yeni nesil ekosistemi.</h3>
                <p>
                    Rune; bağımsız yapımlardan devasa bütçeli hitlere kadar binlerce oyunu tek bir çatı altında toplayan
                    yeni nesil dijital oyun platformudur. Kütüphaneni dilediğin gibi yönet, atölye desteğiyle oyunlarını
                    modla, arkadaşlarınla sesli sohbet et ve canlı topluluk pazaryerinde ticaret yap. Geliştiriciler
                    için adil bir pazar, oyuncular için kesintisiz bir deneyim sunuyoruz.
                </p>
            </div>
            <div class="rune-footer-column">
                <h3>Keşfet</h3>
                <a href="#">Popüler Oyunlar</a>
                <a href="#">Öne Çıkanlar</a>
                <a href="#">Çok Satanlar</a>
                <a href="#">Yakında Gelecekler</a>
                <a href="#">İndirimler & Fırsatlar</a>
                <a href="#">Ücretsiz Oyunlar</a>
            </div>
            <div class="rune-footer-column">
                <h3>Topluluk</h3>
                <a href="#">Forumlar & Tartışmalar</a>
                <a href="#">Topluluk Pazarı</a>
                <a href="#">Atölye (Modlar)</a>
                <a href="#">Etkinlikler & Turnuvalar</a>
                <a href="#">Canlı Yayınlar</a>
            </div>
            <div class="rune-footer-column">
                <h3>Rune hakkında</h3>
                <a href="#">Destek Merkezi</a>
                <a href="#">Sunucu Durumu (Status)</a>
                <a href="#">Güvenlik & Hile Bildirimi</a>
                <a href="#">Hakkımızda</a>
                <a href="#">Kariyer</a>
            </div>
            <div class="rune-footer-column">
                <h3>Yasal</h3>
                <a href="#">Gizlilik politikası</a>
                <a href="#">Kullanım koşulları</a>
                <a href="#">Çerez politikası</a>
                <a href="#">KVKK</a>
            </div>
        </div>
        <div class="rune-footer-bottom">
            <p>© 2026 Rune. Gösterilen tüm oyunlar, başlıklar ve ilgili görseller ilgili yayıncıların tescilli
                markalarıdır.</p>

                <div class="rune-footer-bottom-right">
                    <a href="#">Gizlilik</a>
                    <a href="#">Koşullar</a>
                    <span>TR · Türkiye</span>

                    <button type="button" class="rune-back-to-top"
                            onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
                        <span>↑</span>
                        Yukarı çık
                    </button>
                </div>
            </div>
        </footer>

        <div class="whats-new-overlay" id="whatsNewOverlay" hidden>
            <section class="whats-new-dialog" id="whatsNewDialog" role="dialog" aria-modal="true"
                     aria-labelledby="whatsNewTitle" aria-describedby="whatsNewDescription" data-release-version="@runeVersion"
                     tabindex="-1">
                <button class="whats-new-close" id="whatsNewClose" type="button" aria-label="Güncelleme penceresini kapat"
                        title="Kapat">
                    <span class="mb-2" aria-hidden="true">×</span>
                </button>

                <header class="whats-new-header">
                    <span class="whats-new-eyebrow">Rune · Güncelleme Yamaları</span>
                    <h2 id="whatsNewTitle">Yenilikler</h2>
                    <p id="whatsNewDescription">Eklenen, güncellenen ve kaldırılanları burada görebilirsin.</p>
                </header>

                <div class="whats-new-history">
                    <article class="whats-new-release">
                        <header class="whats-new-release-header">
                            <h3>@runeVersion</h3>
                            <time datetime="2026-11-10">11 Kas 2026</time>
                        </header>

                        <div class="whats-new-categories">
                            <section class="whats-new-category" data-update-category="new">
                                <h4><span class="whats-new-label">Yeni</span></h4>
                                <ul>
                                    <li>Oyunun detay safyası getirldi.</li>
                                </ul>
                            </section>

                            <section class="whats-new-category" data-update-category="updated">
                                <h4><span class="whats-new-label">Güncellendi</span></h4>
                                <ul>
                                    <li>İconlar daha iyi hale getirldi.</li>
                                    <li>Grand Theft Auto VI görseli gelmemesi giderildi.</li>
                                    <li></li>
                                </ul>
                            </section>

                            <section class="whats-new-category" data-update-category="removed">
                                <h4><span class="whats-new-label">Kaldırıldı</span></h4>
                                <ul>
                                    <li>Cadılar bayramı posteri kaldırıldı.</li>
                                </ul>
                            </section>
                        </div>
                    </article>
                </div>
            </section>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
