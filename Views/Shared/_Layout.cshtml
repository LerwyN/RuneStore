                                     class="icon icon-tabler icons-tabler-outline icon-tabler-bookmark">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M18 7v14l-6 -4l-6 4v-14a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4" />
                                </svg>
                            </a>
                        </div>
                        <div class="utility-item">
                            <a href="#" title="Hediye Et">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-gift">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path
                                    d="M3 9a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1l0 -2" />
                                    <path d="M12 8l0 13" />
                                    <path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7" />
                                    <path
                                    d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5" />
                                </svg>
                            </a>
                        </div>
                        <div class="utility-item">
                            <a href="#" title="Sepetim">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-cart">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M4 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                    <path d="M15 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                                    <path d="M17 17h-11v-14h-2" />
                                    <path d="M6 5l14 1l-1 7h-13" />
                                </svg>
                            </a>
                        </div>
                    </div>
        
                    <div class="profile-card">
                        <a class="user-icon" title="Profilim" href="#">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
                                 stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                                 class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                                <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                            </svg>
                        </a>
                        <div class="profile-info">
                            <h6 class="profile-name">@(User.Identity?.Name ?? "Rune User")</h6>
                            <p class="profile-level">Seviye 1</p>
                        </div>
                        <button class="profile-menu-toggle" id="profileMenuToggle" type="button"
                                aria-label="Profil menüsünü aç" aria-expanded="false">
                            <img class="" src="https://img.icons8.com/?size=100&id=99991&format=png&color=ffffff" alt="">
                        </button>
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="profile-dropdown-header">
                                <strong>@(User.Identity?.Name ?? "Rune User")</strong>
                            </div>
                            <a href="#" class="profile-dropdown-item">
                                Profilim
                            </a>
                            <a href="#" class="profile-dropdown-item">
                                Ayarlar
                            </a>
                            
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="profile-dropdown-item logout-link">Çıkış Yap
                                </button>
                            </form>

                            <a class="profile-dropdown-item whats-new-trigger" href="#whatsNewOverlay" data-whats-new-open
                               aria-haspopup="dialog" aria-controls="whatsNewOverlay"
                               title="Rune'de neler değişti haberdar ol">
                                <span>Sürüm Yamaları</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <a class="rune-login-trigger" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a class="rune-register-trigger" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                }
            </div>

            <button class="mobile-menu-button" id="mobileMenuToggle" type="button" aria-label="Menüyü aç"
                    aria-expanded="false" aria-controls="mobileMenu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
        
        <nav class="mobile-menu" id="mobileMenu">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mobile-menu-profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
                         stroke="#FFFFFF" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                        <path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                        <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                    </svg>
                    <div>
                        <strong>@(User.Identity?.Name ?? "Rune User")</strong>
                        <p>Seviye 1</p>
                    </div>
                </div>
            }
            else
            {
                <div class="mobile-auth-actions mt-2">
                    <a class="rune-login-trigger" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a class="rune-register-trigger" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                </div>
                <span></span>
            }

            <a asp-controller="Home" asp-action="Index">
                Mağaza
            </a>
            <a asp-controller="Library" asp-action="Index">
                Atölye
            </a>
            <a asp-controller="Community" asp-action="Index">
                Topluluk
            </a>
            <a asp-controller="News" asp-action="Index">
                Haberler
            </a>
            <a asp-controller="Support" asp-action="Index">
                Destek
            </a>
            <div class="mobile-menu-divider"></div>

            @* Sepet,İstek Listesi ve Hediye et burada olacak *@

            <a href="#">
                Profilim
            </a>
            
            <a href="#">
                Ayarlar
            </a>
            
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="profile-dropdown-item logout-link">Çıkış Yap
                </button>
            </form>
            <a class="whats-new-trigger mobile-menu-whats-new" href="#whatsNewOverlay" data-whats-new-open
               aria-controls="whatsNewOverlay" title="Rune'de neler değişti haberdar ol">
                <span class="mobile-menu-whats-new-copy">
                    <strong>Sürüm Notları</strong>
                </span>
            </a>
        </nav>
    </header>


    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
