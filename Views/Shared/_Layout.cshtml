@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var releaseNotes = ViewData["ReleaseNotes"] as List<RUNE.Models.ReleaseNotes.ReleaseNote> ?? new
    List<RUNE.Models.ReleaseNotes.ReleaseNote>();
    var runeVersion = releaseNotes.FirstOrDefault()?.Version ?? "Rune";
}
<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="/images/icons/RuneDarkIcon.png">
</head>

<body>
    @if (TempData["SuccessTitle"] is string successTitle && TempData["SuccessMessage"] is string successMessage)
    {
        <div class="rune-success-toast" role="status" aria-live="polite">
            <span class="rune-success-toast-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" focusable="false">
                    <path d="m5 12 4.2 4.2L19 6.5" />
                </svg>
            </span>
            <span class="rune-success-toast-copy">
                <strong>@successTitle</strong>
                <span>@successMessage</span>
            </span>
        </div>
    }
    <header class="site-header">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a class="rune-icon" asp-controller="Home" asp-action="Index" aria-label="Rune mağazasına dön">
                    <img src="/images/icons/RuneStore.png" alt="rune">
                </a>
            </div>
            <nav class="navbar-middle">
                <div class="nav-dropdown">
                    <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")"
                       title="Sıradaki Maceranı Keşfet">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-shopping-bag">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path
                            d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304" />
                            <path d="M9 11v-5a3 3 0 0 1 6 0v5" />
                        </svg>
                        Mağaza
                    </a>
                    <div class="nav-dropdown-menu">
                        <a href="/">Ana Sayfa</a>
                        <a href="#">Tüm Oyunlar</a>
                        <a href="#">Kategoriler</a>
                        <a href="#">Sıralamalar</a>
                        <a href="#">Yakında Çıkacaklar</a>
                        <a href="#">İndirimler ve Fırsatlar</a>
                        <a href="#">İstek Listesi</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <a asp-controller="WorkShop" asp-action="Index"
                       class="@(currentController == "WorkShop" ? "active" : "")" title="Atölye Keşfet">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="19" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-tool">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path
                            d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" />
                        </svg>
                        Atölye
                    </a>
                    <div class="nav-dropdown-menu">
                        <a href="/">Ana Sayfa</a>
                        <a href="#">Popüler Modlar</a>
                        <a href="#">Yeni Modlar</a>
                        <a href="#">Koleksiyonlar</a>
                        <a href="#">İçerik Yükle</a>
                        <a href="#">Takip Edilenler</a>
                    </div>
                </div>
                <div class="nav-dropdown">
                    <a asp-controller="Community" asp-action="Index"
                       class="@(currentController == "Community" ? "active" : "")"
                       title="Oyun Dünyasının Buluşma Noktası">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-users">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                            <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                            <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                        </svg>
                        Topluluk
                    </a>
                    <div class="nav-dropdown-menu">
                        <a href="/">Ana Sayfa</a>
                        <a href="#">Tartışmalar</a>
                        <a href="#">Pazar</a>
                        <a href="#">Yayınlar</a>
                        <a href="#">Gruplar</a>
                        <a href="#">Etkinlikler</a>
                        <a href="#">Arkadaşlarım</a>
                    </div>
                </div>
                
                <a asp-controller="News" asp-action="Index" class="@(currentController == "News" ? "active" : "")"
                   title="Oyun Dünyasından Haberdar Ol">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-news">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path
                        d="M16 6h3a1 1 0 0 1 1 1v11a2 2 0 0 1 -4 0v-13a1 1 0 0 0 -1 -1h-10a1 1 0 0 0 -1 1v12a3 3 0 0 0 3 3h11" />
                        <path d="M8 8l4 0" />
                        <path d="M8 12l4 0" />
                        <path d="M8 16l4 0" />
                    </svg>
                    Haberler
                </a>
                <a asp-controller="Support" asp-action="Index" class="@(currentController == "Support" ? "active" : "")"
                   title="Her Adımda Yanındayız">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-help">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                        <path d="M12 17l0 .01" />
                        <path d="M12 13.5a1.5 1.5 0 0 1 1 -1.5a2.6 2.6 0 1 0 -3 -4" />
                    </svg>
                    Destek
                </a>
                <span class="nav-divider"></span>
                <a href="#" title="Oyun Dünyası Seni Bekliyor">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
                         class="icon icon-tabler icons-tabler-outline icon-tabler-download">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
                        <path d="M7 11l5 5l5 -5" />
                        <path d="M12 4l0 12" />
                    </svg>
                    Rune'yi İndir
                </a>
                <span class="nav-active-pill"></span>
            </nav>
            <div class="navbar-right">

                @* Diller eklenecek *@
                

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="wishlist-icon">
                        <div class="utility-item">
                            <a href="#wishlistOverlay" data-wishlist-open aria-haspopup="dialog"
                               aria-controls="wishlistOverlay" title="İstek Listesi">
