        @if (releaseNotes.Count > 0)
        {
            <div class="whats-new-overlay" id="whatsNewOverlay" hidden>
                <section class="whats-new-dialog" id="whatsNewDialog" role="dialog" aria-modal="true"
                         aria-labelledby="whatsNewTitle" aria-describedby="whatsNewDescription" data-release-version="@runeVersion"
                         tabindex="-1">
                    <button class="whats-new-close" id="whatsNewClose" type="button" aria-label="Güncelleme penceresini kapat"
                            title="Kapat">
                        <span class="mb-2" aria-hidden="true">×</span>
                    </button>

                    <header class="whats-new-header">
                        <span class="whats-new-eyebrow">Rune · Sürüm Notları</span>
                        <h2 id="whatsNewTitle">Yenilikler</h2>
                        <p id="whatsNewDescription">Eklenenler, düzeltilenler ve kaldırılanları buradan görebilirsiniz.</p>
                    </header>

                    <div class="whats-new-history">
                        @foreach (var versionGroup in releaseNotes
                            .GroupBy(note => note.Version)
                            .OrderByDescending(group => group.Max(note => note.ReleaseDate)))
                        {
                            var releaseDate = versionGroup.Max(note => note.ReleaseDate);
                            var releaseDateIso = releaseDate.ToString("yyyy-MM-dd");
                            var releaseDateDisplay = releaseDate.ToString("d MMM yyyy",
                    System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
                            <article class="whats-new-release">
                                <header class="whats-new-release-header">
                                    <h3>@versionGroup.Key</h3>
                                    <time datetime="@releaseDateIso">@releaseDateDisplay</time>
                                </header>

                                <div class="whats-new-categories">
                                    @foreach (var category in Enum.GetValues<RUNE.Models.ReleaseNotes.ReleaseNoteCategory>())
                                    {
                                        var categoryNotes = versionGroup
                                            .Where(note => note.Category == category)
                                            .OrderBy(note => note.DisplayOrder)
                                            .ToList();
                                        if (categoryNotes.Count == 0)
                                        {
                                            continue;
                                        }

                                        var categoryLabel = category switch
                                        {
                                            RUNE.Models.ReleaseNotes.ReleaseNoteCategory.New => "Yeni",
                                            RUNE.Models.ReleaseNotes.ReleaseNoteCategory.Updated => "Güncellendi",
                                            RUNE.Models.ReleaseNotes.ReleaseNoteCategory.Removed => "Kaldırıldı",
                                            _ => category.ToString()
                                        };
                                        <section class="whats-new-category"
                                                 data-update-category="@category.ToString().ToLowerInvariant()">
                                            <h4><span class="whats-new-label">@categoryLabel</span></h4>
                                            <ul>
                                                @foreach (var note in categoryNotes)
                                                {
                                                    <li>@note.Description</li>
                                                }
                                            </ul>
                                        </section>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            </div>
        }

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

